# ═══ ISHKO'P Production .env ═══
# Copy this to /var/www/jobboard/backend/.env and fill in values

# Bot
BOT_TOKEN=YOUR_BOT_TOKEN_HERE
TELEGRAM_CHANNEL_IDS=

# URLs
WEBHOOK_URL=https://webhookishkop.1wash.uz/webhook
MINI_APP_URL=https://webapp.1wash.uz

# Frontend env (put in /var/www/jobboard/frontend/.env)
# VITE_API_URL=https://webapp.1wash.uz
# VITE_TELEGRAM_BOT_NAME=YourBotUsername

# Database
DATABASE_URL=postgresql+asyncpg://ishkop_user:YOUR_DB_PASSWORD@localhost:5432/ishkop_db

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=YOUR_RANDOM_SECRET_KEY_HERE
ALGORITHM=HS256

# Google Cloud Storage (optional)
# GCS_BUCKET_NAME=
# GCS_CREDENTIALS_FILE=
# GCS_PUBLIC_BASE_URL=
