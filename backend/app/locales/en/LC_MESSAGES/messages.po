msgid "welcome_back"
msgstr ""
"Welcome back, {name}! 🚀\n"
"\n"
"Ready to find your dream job or the perfect candidate? Our Mini App makes it easier than ever.\n"
"\n"
"✨ **Discover what's possible:**\n"
"• Browse exclusive vacancies\n"
"• Create a stunning resume\n"
"• Connect instantly with top employers\n"
"\n"
"Tap below to start your journey! 👇"

msgid "select_language"
msgstr "Welcome! Please select your language to continue:"

msgid "share_contact_request"
msgstr ""
"Great choice! 🌟\n"
"\n"
"To ensure account security and give you full access to all features, we need to verify your phone number.\n"
"\n"
"Please share your contact below to proceed safely."

msgid "share_own_contact"
msgstr "Please share your own contact."

msgid "registration_complete"
msgstr "✨ Registration complete!"

msgid "open_mini_app"
msgstr "🤖 Open Mini App"

msgid "app_description"
msgstr ""
"Your professional journey starts here! 🚀\n"
"\n"
"With our Mini App, you can:\n"
"✅ Build a powerful resume in minutes\n"
"✅ Post jobs and find top talent instantly\n"
"✅ Get real-time alerts for new opportunities\n"
"\n"
"Tap the button below to launch the experience! ✨"

msgid "share_contact_button"
msgstr "Share Contact"

msgid "ok"
msgstr "ok"
